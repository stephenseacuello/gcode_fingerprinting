{
  "name": "large_ensemble",
  "description": "Large ensemble - 3 models with different seeds, moderate scaling",

  "architecture": {
    "d_model": 512,
    "n_layers": 7,
    "n_heads": 16,
    "d_ff_multiplier": 4.0,
    "dropout": 0.35,
    "embed_dropout": 0.18,
    "sensor_dim": 192,
    "operation_embed_dim": 48,
    "drop_path_rate": 0.13
  },

  "encoder": {
    "hidden_dim": 384,
    "lstm_layers": 2,
    "use_enhanced_encoder": true,
    "use_multihead_pooling": true,
    "pooling_n_heads": 6,
    "pooling_n_queries": 12
  },

  "training": {
    "seeds": [123, 42, 456],
    "batch_size": 24,
    "max_epochs": 150,
    "patience": 40,
    "learning_rate": 0.00018,
    "weight_decay": 0.055,
    "warmup_epochs": 12,
    "lr_scheduler": "cosine_restarts",
    "restart_period": 20,
    "min_lr": 1e-6,
    "grad_clip": 1.0,
    "label_smoothing": 0.11
  },

  "features": {
    "use_sensor_prior": true,
    "sensor_prior_weight": 0.52,
    "augment": true,
    "augment_prob": 0.28,
    "progressive_augmentation": true,
    "use_error_sampling": true,
    "error_boost": 1.6,
    "use_position_weights": true,
    "position_weight_scale": 3.0
  },

  "notes": "Moderate scaling (d_model=512, 7 layers) with 3 seeds for ensemble diversity. Balanced between capacity and training efficiency."
}
