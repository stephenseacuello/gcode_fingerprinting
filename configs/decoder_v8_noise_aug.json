{
    "_description": "V8 decoder (decoder20260511) — no shortcuts + noise/token-mask augmentation. Phase-4 stress-test config.",
    "_date": "2026-05-11",
    "_audit_ref": "outputs/decoder20260511/AUDIT_REPORT.md",
    "_notes": [
        "Inherits decoder_v8_no_shortcuts.json defaults and turns on the augmentation knobs Romesh proposed in the 2026-04-28 meeting.",
        "token_mask_prob masks input tokens during teacher forcing, forcing the decoder to lean on sensor memory rather than autoregressive context.",
        "sensor_noise_std is on the small side; raise if the decoder still overfits to shortcuts."
    ],

    "model": {
        "d_model": 384,
        "n_heads": 12,
        "n_layers": 8,
        "dropout": 0.1,
        "embed_dropout": 0.15,
        "sensor_dim": 256,
        "n_operations": 9,
        "n_types": 4,
        "n_commands": 6,
        "n_param_types": 10,
        "max_seq_len": 32,
        "use_window_position": false,
        "position_dropout": 1.0,
        "use_sensor_prior": true,
        "use_pointer_network": false,
        "memory_pos_encoding": true,
        "use_sequence_classifier": false
    },

    "data": {
        "label_mode": "per_row",
        "expose_position_metadata": false,
        "multi_window_context": 0,
        "window_dropout": 0.0
    },

    "augmentation": {
        "enabled": true,
        "sensor_noise_std": 0.02,
        "feature_dropout_prob": 0.10,
        "token_mask_prob": 0.05,
        "augment_prob": 0.4,
        "scale_range": [0.97, 1.03],
        "shift_range": 1,
        "cutout_length": 3,
        "jitter_sigma": 0.008
    },

    "training": {
        "batch_size": 64,
        "max_epochs": 200,
        "patience": 40,
        "track_metric": "token"
    },

    "optimizer": {
        "type": "adamw",
        "learning_rate": 1e-4,
        "weight_decay": 0.05
    },

    "loss": {
        "use_focal_loss": false,
        "type_weight": 1.0,
        "command_weight": 2.0,
        "param_type_weight": 1.5,
        "digit_weight": 1.0,
        "legacy_weight": 1.0
    },

    "scheduled_sampling": {
        "enabled": true,
        "start_ratio": 1.0,
        "end_ratio": 0.5
    },

    "paths": {
        "vocab_path": "data/gcode_vocab_v8.json",
        "encoder_path": "outputs/experiments_2026_02_25/full_w256_s64_cv"
    },

    "wandb": {
        "project": "decoder20260511",
        "enabled": false
    }
}
