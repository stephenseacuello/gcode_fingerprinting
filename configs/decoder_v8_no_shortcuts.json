{
    "_description": "V8 decoder (decoder20260511) — shortcut-free baseline. Used to isolate sensor contribution.",
    "_date": "2026-05-11",
    "_audit_ref": "outputs/decoder20260511/AUDIT_REPORT.md",
    "_notes": [
        "use_window_position=false kills the V7 shortcut path that gave 75-95% test accuracy from window_index/source_file alone.",
        "multi_window_context=0 disables the MWC wrapper to keep the test clean.",
        "Per-row mode picks the smaller max_seq_len; full_window mode requires a much larger cap (1500+).",
        "max_seq_len is the model architecture cap; the dataset auto-resolves to the actual NPZ max."
    ],

    "model": {
        "d_model": 384,
        "n_heads": 12,
        "n_layers": 8,
        "dropout": 0.1,
        "embed_dropout": 0.1,
        "sensor_dim": 256,
        "n_operations": 9,
        "n_types": 4,
        "n_commands": 6,
        "n_param_types": 10,
        "max_seq_len": 32,
        "use_window_position": false,
        "position_dropout": 1.0,
        "use_sensor_prior": true,
        "use_pointer_network": false,
        "memory_pos_encoding": true,
        "use_sequence_classifier": false
    },

    "data": {
        "label_mode": "per_row",
        "expose_position_metadata": false,
        "multi_window_context": 0,
        "window_dropout": 0.0
    },

    "training": {
        "batch_size": 64,
        "max_epochs": 200,
        "patience": 40,
        "track_metric": "token"
    },

    "optimizer": {
        "type": "adamw",
        "learning_rate": 1e-4,
        "weight_decay": 0.05
    },

    "loss": {
        "use_focal_loss": false,
        "type_weight": 1.0,
        "command_weight": 2.0,
        "param_type_weight": 1.5,
        "digit_weight": 1.0,
        "legacy_weight": 1.0
    },

    "scheduled_sampling": {
        "enabled": true,
        "start_ratio": 1.0,
        "end_ratio": 0.5
    },

    "paths": {
        "vocab_path": "data/gcode_vocab_712.json",
        "encoder_path": "outputs/experiments_2026_02_25/full_w256_s64_cv"
    },

    "wandb": {
        "project": "decoder20260511",
        "enabled": false
    }
}
